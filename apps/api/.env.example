# Dev = PostgreSQL local (base "vlome"). Copier en .env (non committé).
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/vlome?schema=public"

# Secret JWT pour l'authentification (à changer en production)
JWT_SECRET="change-me-in-production"

# Port d'écoute de l'API (défaut : 4000)
API_PORT=4000

# Stockage des fichiers envoyés (logo, affiches, produits…). Sans cette variable,
# les fichiers sont écrits sur disque local (OK en dev, mais ça ne marche pas sur
# Vercel : système de fichiers en lecture seule). En production, crée un compte
# Cloudinary (gratuit) et colle la valeur "API Environment variable" affichée sur
# le dashboard Cloudinary — déjà au format cloudinary://clé:secret@cloud_name.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Paiement en ligne (les clés ne vont JAMAIS dans le code ni dans git : ici en local, et dans les
# variables d'environnement du projet API sur Vercel). Sans clé, la passerelle correspondante est
# simplement masquée sur le site.
# URL publique du site (retour de paiement FedaPay) — en local : http://localhost:3100 (ou le port du web)
# SITE_URL=https://www.miabe-esport.community
# FedaPay : clé SECRÈTE (sk_live_… / sk_sandbox_…). FEDAPAY_ENV=sandbox pour tester avec une clé sandbox.
# FEDAPAY_SECRET_KEY=sk_live_xxxxxxxx
# FEDAPAY_ENV=live
# KkiaPay : clé publique + clé secrète (tsk_…) et, si le tableau de bord en fournit une, la clé privée (tpk_…).
# KKIAPAY_PUBLIC_KEY=xxxxxxxx
# KKIAPAY_SECRET_KEY=tsk_xxxxxxxx
# KKIAPAY_PRIVATE_KEY=tpk_xxxxxxxx
# KKIAPAY_SANDBOX=false
