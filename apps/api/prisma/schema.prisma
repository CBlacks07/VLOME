// VLOME Esport — schéma PostgreSQL
// Sortie locale (pas dans node_modules) : évite les soucis de résolution du
// paquet @prisma/client hors monorepo pnpm hoisté (ex. build Vercel). Générée
// à la racine du package (pas sous src/) pour que le chemin relatif depuis
// prisma.service.ts reste valide identiquement en dev (ts-node, depuis src/)
// et en prod (node dist/main.js, depuis dist/), les deux arborescences ayant
// la même profondeur sous generated/.
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  // "native" = binaire local (Windows en dev) ; les autres = runtime Vercel
  // (Amazon Linux 2023 / anciennes images) — sans ça le moteur de requête
  // généré peut ne pas correspondre à l'environnement d'exécution réel.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ORGANIZER
  ADMIN
  ASSOCIATION // compte d'association : pilote son club (membres, profil, intégration)
}

enum TournamentFormat {
  SURVIVAL
  SINGLE_ELIM
  DOUBLE_ELIM
  SWISS
  ROUND_ROBIN
  POOLS
  BATTLE_ROYALE
}

// Palier affiché sur la page Tournois (badge + regroupement uniquement, sans effet sur les points de
// classement) — repris du système joué pour la GAL 3. Facultatif : pas de valeur tant que l'organisateur
// n'en choisit pas une.
enum TournamentTier {
  AMATEUR
  ELITE
}

enum TournamentStatus {
  DRAFT
  LIVE
  FINISHED
}

enum LoyaltyReason {
  PARTICIPATION // +1 point, inscription validée à un tournoi Vlome
  ORDER_REDEMPTION // -N points, dépensés en boutique
  REGISTRATION_REDEMPTION // -N points, dépensés sur des frais d'inscription
  ADMIN_ADJUST // +/- N, ajustement manuel
  REFUND // +N points, désinscription (rembourse points dépensés / retire le point gagné)
}

enum CreditReason {
  PURCHASE // +N, achat de crédits confirmé par l'admin
  TOURNAMENT_HOST // -1, création d'un tournoi au-delà du tournoi gratuit
  ADMIN_ADJUST // +/- N, ajustement manuel
  REFUND // +1, tournoi supprimé avant d'avoir été lancé
}

enum OrganizerStatus {
  NONE // pas organisateur (PLAYER/ADMIN), ou pas encore concerné
  PENDING // demande soumise à l'inscription, en attente de validation admin
  APPROVED // validé par l'admin — peut créer des tournois (sous réserve des crédits et des plafonds ci-dessous)
  REJECTED // demande refusée par l'admin
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  displayName         String
  displayNameChangedAt DateTime? // dernier renommage — le pseudo n'est modifiable qu'1x/30 jours (voir UsersService.updateMe)
  role                Role                 @default(PLAYER)
  bio                 String?
  avatarUrl           String? // photo de profil, posée uniquement par POST /uploads/avatar
  city                String?
  favoriteGame        String?
  phone               String? // téléphone/WhatsApp — requis pour un organisateur (suivi des crédits)
  loyaltyPoints       Int                  @default(0) // solde courant, dénormalisé depuis LoyaltyTransaction
  organizerCredits    Int                  @default(0) // solde de crédits organisateur (1 crédit = 1 tournoi hébergé), dénormalisé depuis CreditTransaction
  freeTournamentsUsed Int                  @default(0) // nombre de tournois gratuits déjà consommés (comparé au quota réglable admin)
  // Validation manuelle du statut organisateur — un compte ORGANIZER ne peut créer de tournoi
  // qu'une fois APPROVED. Les crédits ci-dessus restent le mécanisme de paiement ; ces champs
  // ajoutent un plafond/portée fixé par l'admin à l'approbation (indépendant du solde de crédits).
  organizerStatus          OrganizerStatus @default(NONE)
  organizerNote            String? // motivation présentée par le candidat à l'inscription
  organizerMaxTournaments  Int? // plafond total de tournois créables, fixé par l'admin (null = pas de plafond)
  organizerMaxPlayers      Int? // nb max de participants par tournoi qu'il crée, fixé par l'admin (null = pas de plafond)
  organizerReviewedAt      DateTime?
  // Club demandé à l'inscription (ou depuis le profil) : il n'entre dans le catalogue de clubs et sur la fiche
  // joueur qu'une fois validé par un admin. clubBlocking = demande faite à l'inscription : le compte ne peut
  // rien faire d'autre que consulter le site tant qu'elle n'est pas traitée.
  clubRequested            String?
  clubRequestedId          String? // identifiant du club choisi dans la liste (adhésion à valider par l'association du club)
  clubStatus               String    @default("NONE") // 'NONE' | 'PENDING' | 'APPROVED' | 'REJECTED'
  clubBlocking             Boolean   @default(false)
  clubReviewedAt           DateTime?
  createdAt           DateTime             @default(now())
  player              Player?
  registrations       Registration[]
  predictions         Prediction[]
  orders              Order[]
  loyaltyTxs          LoyaltyTransaction[]
  creditTxs           CreditTransaction[]
  creditPurchases     CreditPurchase[]
  ownedClub           Club?                @relation("ClubOwner")
  passwordResets      PasswordReset[]
}

// Demande de réinitialisation de mot de passe. Seul le HACHÉ du jeton est stocké : une fuite de
// cette table ne permettrait donc pas de prendre la main sur les comptes (même raisonnement que
// pour les mots de passe). Jeton à usage unique et de courte durée.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Journal des gains/dépenses de crédits organisateur — même rôle que LoyaltyTransaction
// (historique + preuve en cas d'écart avec User.organizerCredits dénormalisé).
model CreditTransaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int // signé : +5 (achat), -1 (hébergement d'un tournoi)…
  reason       CreditReason
  tournamentId String? // tournoi hébergé (consommation) ou supprimé (remboursement)
  purchaseId   String? // achat de crédits ayant généré ce crédit
  note         String?
  createdAt    DateTime     @default(now())
}

// Demande d'achat de crédits organisateur — même flux de confirmation manuelle que Order/Registration
// (pas de passerelle de paiement : l'organisateur choisit un moyen de paiement, un admin confirme
// à réception avant que les crédits ne soient effectivement crédités).
model CreditPurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits       Int
  amountXof     Int
  paymentMethod String
  status        String   @default("pending") // 'pending' | 'paid'
  createdAt     DateTime @default(now())
}

// Journal des gains/dépenses de points fidélité — sert à la fois d'historique
// consultable et de preuve en cas d'écart avec User.loyaltyPoints (dénormalisé).
model LoyaltyTransaction {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // signé : +1, -50…
  reason         LoyaltyReason
  registrationId String? // participation ayant généré le point, ou frais d'inscription payés en points
  orderId        String? // commande boutique payée (en partie) en points
  note           String?
  createdAt      DateTime      @default(now())
}

// Inscription d'un utilisateur à un tournoi (avant lancement)
model Registration {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerName     String
  amountXof      Int        @default(0)
  paymentMethod  String? // Flooz, Mixx by Yas, Visa... (null si gratuit)
  paymentStatus  String     @default("paid") // 'paid' (gratuit ou confirmé) | 'pending' (paiement à confirmer)
  pointsRedeemed Int        @default(0) // points fidélité utilisés pour réduire amountXof
  checkedInAt    DateTime? // présence confirmée sur place (QR code scanné ou pointage manuel) ; null = pas encore arrivé
  createdAt      DateTime   @default(now())

  @@unique([userId, tournamentId])
}

model Club {
  id      String   @id @default(cuid())
  name    String   @unique
  city    String?
  logoUrl String?
  players Player[]
  // Association propriétaire : son compte (rôle ASSOCIATION) valide les adhésions et récupère les codes d'intégration.
  slug         String?  @unique // adresse publique (pages et widgets embarqués)
  status       String   @default("APPROVED") // 'PENDING' (association à valider par l'admin) | 'APPROVED' | 'REJECTED'
  website      String?
  description  String?
  contactEmail String?
  ownerId      String?  @unique
  owner        User?    @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  memberships  ClubMembership[]
}

// Lien joueur <-> club, avec son histoire. status : 'requested' (le joueur demande) | 'invited' (le club invite) | 'active' |
// 'left' (parti) | 'removed' (retiré) | 'rejected' (demande ou invitation refusée) | 'cancelled' (retirée avant réponse).
// Un seul 'active' par joueur (index unique partiel posé dans la migration). Player.clubId en est le reflet, écrit
// uniquement par MembershipService.
model ClubMembership {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status      String
  initiatedBy String    @default("player") // 'player' | 'club' | 'admin'
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  endedAt     DateTime?

  @@index([clubId, status])
  @@index([playerId, status])
}

// Catalogue des jeux (site-wide, géré depuis l'admin) — propose des noms canoniques à la création
// d'un tournoi pour éviter les doublons de casse/orthographe ("Valorant" vs "valorant") qui
// fausseraient les classements et stats par jeu. Le champ Tournament.game reste une simple chaîne
// (pas de clé étrangère) : plus simple, pas de migration à faire sur les données déjà existantes.
model Game {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String? // visuel du jeu : repli des cartes de tournoi sans affiche
  createdAt DateTime @default(now())
}

model Player {
  id        String   @id @default(cuid())
  name      String
  city      String?
  game      String?
  elo       Int      @default(1000)
  points    Int      @default(0)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id])
  claimUserId String? // compte qui demande à reprendre cette fiche (même nom) — validé par l'admin
  createdAt DateTime @default(now())
  memberships ClubMembership[]
}

model Tournament {
  id                String           @id @default(cuid())
  name              String
  game              String?
  format            TournamentFormat @default(SURVIVAL)
  status            TournamentStatus @default(DRAFT)
  date              DateTime?
  place             String?
  pointsPerPlayer   Int              @default(5)
  nbPools           Int              @default(2)
  entryFeeXof       Int              @default(0) // frais d'inscription en FCFA (0 = gratuit)
  givesLoyaltyPoint Boolean          @default(true) // désactivable par l'admin (ex : tournoi organisé par un tiers)
  imageUrl          String? // affiche (portrait) — cartes, liste
  bannerUrl         String? // couverture (paysage) — fond de la page détail ; retombe sur l'affiche si absente
  // état complet du moteur @vlome/engine (JSON natif Postgres)
  engineState       Json?
  createdById       String? // propriétaire (organisateur)
  coAdminIds        String[] @default([]) // autres comptes (organisateur, association, admin) autorisés à piloter ce tournoi
  matchPlans        Json? // heure prévue par match, clé = activeKey côté web : { cle: date ISO } (le lieu est le « poste »)
  announcements     Json? // annonces publiques : [{ id, text, ts, by }]
  activity          Json? // journal des actions de l'organisation : [{ ts, by, text }]
  eventId           String? // événement auquel ce tournoi est rattaché (facultatif)
  event             Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  scheduleItems     EventScheduleItem[]
  createdAt         DateTime         @default(now())
  matches           Match[]
  registrations     Registration[]
  predictions       Prediction[]
  galleryItems      GalleryItem[]
  // Poste/table assigné à chaque match en cours (LAN à plusieurs postes) — clé = activeKey côté web
  // (matchId de phase finale, poolId de poule), valeur = libellé libre ("Table 3", "PC 7"…). Purement
  // indicatif : ne change rien au déroulé du tournoi, juste affiché en régie et sur les écrans publics.
  stations          Json?
  // Match actuellement "à l'antenne" (un seul à la fois) — même clé (activeKey) que stations. Mis en
  // avant dans la file d'attente de la régie et signalé sur l'écran de diffusion.
  streamMatchKey    String?
  // Heure de début (ms) de chaque match lancé en régie, par activeKey — sert au chronomètre par match.
  matchStarts       Json?
  // Durée prévue d'un match (minutes) : au-delà, le chronomètre passe en alerte. Facultatif.
  matchMinutes      Int?
  // Règlement et lot du tournoi (texte libre affiché sur la page publique).
  rules             String?
  prize             String?
  // Tournoi par équipes : taille des équipes (null = individuel) et composition { nomÉquipe: [joueurs] }.
  // Côté moteur, chaque équipe est UN concurrent (Player nommé comme l'équipe) : bracket, poules et classements
  // fonctionnent tels quels.
  teamSize          Int?
  teams             Json?
  tier              TournamentTier?  // facultatif — pas de palier tant que l'organisateur n'en choisit pas un
  // Nombre maximum de participants (null = illimité). Au-delà, l'inscription en ligne est refusée (« complet »).
  maxPlayers        Int?
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  stage        String
  playerAId    String?
  playerBId    String?
  scoreA       Int        @default(0)
  scoreB       Int        @default(0)
  winnerId     String?
  playedAt     DateTime?
}

// Réglages éditables du site (identité, héro, slider, partenaires…)
model Setting {
  key   String @id
  value Json
}

// Catalogue (album) de la galerie : regroupe des médias sous un même titre — ex. « Survival Cup 2026 ».
// Supprimer un album ne supprime pas ses médias : ils repassent simplement « hors catalogue ».
model GalleryAlbum {
  id          String        @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime      @default(now())
  items       GalleryItem[]
}

// Galerie : photos/vidéos des événements (LAN, finales, remises de prix…)
model GalleryItem {
  id           String        @id @default(cuid())
  title        String
  mediaUrl     String // image ou vidéo (/uploads/...)
  mediaType    String        @default("image") // 'image' | 'video'
  tournamentId String?
  tournament   Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  albumId      String?
  album        GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  body      String
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id              String   @id @default(cuid())
  name            String
  category        String
  priceXof        Int // prix en FCFA
  stock           Int      @default(0)
  imageUrl        String?
  loyaltyEligible Boolean  @default(false) // réduction en points possible sur ce produit (choix admin)
  showOnHome      Boolean  @default(false) // affiché dans le carrousel boutique de l'accueil (choix admin)
  description     String? // texte libre affiché sur la fiche produit
  createdAt       DateTime @default(now())
}

model Order {
  id             String   @id @default(cuid())
  reference      String   @unique
  totalXof       Int
  paymentMethod  String // Flooz, Mixx by Yas, Visa...
  status         String   @default("pending")
  items          Json? // [{ name, price }]
  pointsRedeemed Int      @default(0) // points fidélité utilisés pour réduire totalXof
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  // Masquée de la liste admin (rangement) — la commande reste en base, dans les chiffres et dans l'historique du client.
  archived       Boolean  @default(false)
}

// Transaction de paiement en ligne (FedaPay / KkiaPay) rattachée à une inscription, une commande ou un
// achat de crédits. providerTxId est unique : une même transaction approuvée ne peut servir qu'une fois
// (sinon un seul paiement pourrait valider plusieurs commandes). Le montant attendu vient toujours de
// la base, jamais du navigateur.
model OnlinePayment {
  id           String   @id @default(cuid())
  provider     String // 'fedapay' | 'kkiapay'
  kind         String // 'registration' | 'order' | 'credit'
  refId        String
  userId       String?
  amountXof    Int
  providerTxId String?  @unique
  status       String   @default("pending") // 'pending' | 'paid' | 'failed'
  createdAt    DateTime @default(now())

  @@index([kind, refId])
}

// Événement : un cadre (affiche, animation, infos) qui regroupe un ou plusieurs tournois, éventuellement
// joués en même temps. Supprimer un événement détache ses tournois (onDelete: SetNull), ne les supprime pas.
model Event {
  id          String       @id @default(cuid())
  name        String
  tagline     String? // accroche courte
  description String?
  startDate   DateTime?
  endDate     DateTime?
  place       String?
  posterUrl   String? // affiche
  bannerUrl   String? // bannière animée : image, GIF ou vidéo
  accentColor String? // couleur d'accent de la page (#RRGGBB)
  status      String       @default("DRAFT") // 'DRAFT' | 'PUBLISHED'
  createdById String?
  createdAt   DateTime     @default(now())
  tournaments Tournament[]
  schedule    EventScheduleItem[]

  @@index([status, startDate])
}

// Pronostic d'un membre sur le vainqueur d'un match (matchId du moteur) — résolu à la lecture, depuis le
// journal du tournoi : aucune écriture à faire quand le match est joué.
model Prediction {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchKey     String // matchId du match pronostiqué
  pick         String // nom du concurrent choisi
  oddsPct      Int? // % de votes pour ce choix au moment du pronostic (fige la cote pour le bonus outsider)
  createdAt    DateTime   @default(now())

  @@unique([userId, tournamentId, matchKey])
  @@index([tournamentId])
}

// Un point du programme d'un événement (cérémonie, pause, finale…), saisi par l'organisateur avec une date
// et une heure précises — distinct des tournois : un événement a un déroulé qui dépasse le calendrier des
// tournois qui s'y jouent (accueil, remise des prix…), et un tournoi n'a souvent qu'une date sans heure.
model EventScheduleItem {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title        String
  note         String? // détail court affiché sous le titre (lieu précis dans le venue, intervenant…)
  startAt      DateTime
  endAt        DateTime?
  tournamentId String? // relie ce point du programme à un tournoi (ouvre sa page au clic) — facultatif
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([eventId, startAt])
}
